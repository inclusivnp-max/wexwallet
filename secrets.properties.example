# Скопируйте этот файл в secrets.properties и заполните нужные ключи.
#
#     cp secrets.properties.example secrets.properties
#
# secrets.properties находится в .gitignore и не попадёт в репозиторий.
# Задавать нужно только то, что хотите переопределить: любой пропущенный ключ
# берётся из secrets.defaults.properties.
#
# То же самое можно сделать через переменные окружения с такими же именами —
# именно так ключи подставляет CI.
#
# Проверить, что подхватилось (значения не печатаются):
#
#     ./gradlew :app:secretsStatus

# Бесплатный ключ: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Бесплатный ключ: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Бесплатный projectId: https://dashboard.reown.com
WALLETCONNECT_PROJECT_ID=

# Свои RPC-эндпоинты, если публичные не устраивают по лимитам или приватности.
# RPC_ETHEREUM=
# RPC_BASE=
